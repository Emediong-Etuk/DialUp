# DialUp settings for ~/.hermes/.env. Placeholders only: never commit real values.

# --- Try it with no account: SMS go to plugin-data/dialup/outbox.jsonl ---
DIALUP_TRANSPORT=local
DIALUP_ALLOWED_USERS=+2348031234567

# --- Africa's Talking (sandbox or live) ---
# DIALUP_TRANSPORT=africastalking
# AFRICASTALKING_USERNAME=sandbox
# AFRICASTALKING_API_KEY=your-africastalking-api-key
# DIALUP_WEBHOOK_SECRET=generate-with-hermes-dialup-secret
# DIALUP_SERVICE_CODE=*384*55#
# DIALUP_SMS_FROM=

# --- Who may use it ---
# DIALUP_HOME_CHANNEL=+2348031234567
# DIALUP_ALLOW_ALL_USERS=false
# DIALUP_DEFAULT_COUNTRY_CODE=234

# --- Listener ---
# DIALUP_WEBHOOK_HOST=127.0.0.1
# DIALUP_WEBHOOK_PORT=8787
# DIALUP_AT_API_BASE=

# --- Behaviour ---
# DIALUP_QUICK_PROMPTS=Summarise my day|Any urgent email?
